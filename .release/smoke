  @override
  Future<void> fetchCanonicalSnapshot(String callId) async {}
  @override
  Future<void> requestJoinCredential(String callId) async {}
  @override
  Future<void> restoreCallSubscription(String callId) async {}
}

final class _Rtc implements CallRtcSessionPort {
  @override
  Future<void> connect(String callId) async {}
  @override
  Future<void> discardCredential() async {}
  @override
  Future<void> discardMediaKey() async {}
  @override
  Future<void> stopLocalMedia() async {}
}

final class _Os implements CallOsSurfacePort {
  @override
  Future<void> endCall(String? callId) async {}
  @override
  Future<void> reportIncomingCall(String callId) async {}
  @override
  Future<void> updateCall(String callId, CallUiState state) async {}
}

final class _Foreground implements CallForegroundServicePort {
  @override
  Future<void> startForCall(String callId) async {}
  @override
  Future<void> stop() async {}
}
